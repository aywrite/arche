/target
/arche-core/target
# a cargo home installed into the tree, which shell.nix does. Git does not
# look inside an excluded directory, so the build configuration that lives
# in the same place is named back in rather than the directory being left
# out whole.
.cargo/*
!.cargo/config.toml
.rustup

__pycache__/

# what a pip install of scripts/ leaves behind, editable or not
*.egg-info/
/scripts/build/

# profiling
perf.data*
callgrind.out*
dhat.out*
flamegraph.svg*

# agent instructions for one machine, kept out of the repository
/AGENTS.local.md
/CLAUDE.local.md

# the harvested games and the corpus built from them. Hundreds of megabytes,
# and the documented harvest writes both into the working tree by default. They
# are inputs rather than sources and the artifacts are where they come from.
/runs/
/corpus.epd
